; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="vibe-of-duty-p"
config/version="0.1.6"
run/main_scene="res://prefabs/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/version_tag="alpha"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Audio="*res://scripts/autoload/audio.gd"
Net="*res://scripts/autoload/net.gd"
Game="*res://scripts/autoload/game.gd"
Lobby="*res://scripts/autoload/lobby.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/version_bump/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/science-gothic/Science-Gothic-Variable-Fixed.ttf"

