[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="viewmodel"
3d_render/layer_3="train_lower"
3d_render/layer_4="train_upper"
3d_render/layer_5="deck_3"
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="pickup"
3d_physics/layer_5="trigger"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

